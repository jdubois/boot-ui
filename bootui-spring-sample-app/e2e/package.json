{
  "name": "bootui-spring-sample-app-e2e",
  "private": true,
  "version": "1.20.0",
  "description": "Playwright end-to-end integration tests that exercise the BootUI console and the sample Spring Boot application from a real browser.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:custom-path": "playwright test --config=playwright.custom-path.config.js",
    "test:webflux": "playwright test --config=playwright.webflux.config.js",
    "test:agent": "playwright test --config=playwright.agent.config.js",
    "test:agent:opentelemetry-first": "playwright test --config=playwright.agent-opentelemetry-first.config.js",
    "test:agent:opentelemetry-last": "playwright test --config=playwright.agent-opentelemetry-last.config.js",
    "test:agent:jacoco": "playwright test --config=playwright.agent-jacoco.config.js",
    "test:webflux:agent": "playwright test --config=playwright.webflux-agent.config.js",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "screenshots": "node scripts/capture-docs-screenshots.mjs",
    "report": "playwright show-report",
    "format": "prettier --config ../../prettier.config.cjs --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --config ../../prettier.config.cjs --ignore-path ../../.prettierignore --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9",
    "sharp": "0.35.5"
  }
}
