<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.julien-dubois.bootui</groupId>
        <artifactId>bootui-parent</artifactId>
        <version>1.17.0</version>
    </parent>

    <artifactId>bootui-client</artifactId>
    <name>BootUI :: Client</name>
    <description>Framework-free Java client for the BootUI command-line endpoint, shared by the CLI and build plugins.</description>

    <!--
        Deliberately dependency-free at runtime, on the JDK's own HTTP client and a minimal JSON reader.

        Two reasons. A client is embedded in other people's builds, where an extra Jackson (2 or 3) on the
        classpath is a version conflict waiting to happen. And responses must stay opaque: a client built
        against one BootUI version has to keep working against another, so it must not bind server payloads
        to DTO types from bootui-core.
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
