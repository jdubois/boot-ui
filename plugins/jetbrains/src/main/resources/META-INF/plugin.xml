<idea-plugin>
    <id>io.github.jdubois.bootui.jetbrains</id>
    <name>BootUI</name>
    <vendor url="https://github.com/jdubois/boot-ui">BootUI</vendor>
    <description><![CDATA[
        Connect explicitly to a local BootUI application and inspect its overview and panel availability.
        The plugin performs no network requests until Connect or Refresh is clicked.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>org.intellij.groovy</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="BootUI"
                    anchor="right"
                    icon="/icons/bootui.svg"
                    factoryClass="io.github.jdubois.bootui.jetbrains.BootUiToolWindowFactory"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>
</idea-plugin>
