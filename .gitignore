.jdtls-workspace/
nbproject/
nb-configuration.xml

# Java / Maven
target/
# Consumer POMs written by flatten-maven-plugin beside each published module's pom.xml.
.flattened-pom.xml
# Per-worktree local Maven repository used by the GitHub Copilot app scripts.
.m2/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*

# Node / Vue
node/
node_modules/
dist/
coverage/
.npm/
.eslintcache
**/.vuepress/.cache/
**/.vuepress/.temp/
# The showcase video is a GitHub Release asset, downloaded by pages.yml at build time.
docs/.vuepress/public/videos/*.mp4

# BootUI runtime persistence (local developer overrides)
.bootui/

# Impeccable design hook: share the detector config, keep local cache/overrides out
.impeccable/*
!.impeccable/config.json

# Local env
.env
*.env.local

# Per-worktree Maven repo-local override (see docs on isolating parallel worktrees)
/.mvn/maven.config
/bootui-spring-sample-app/Dockerfile-native
/bootui-spring-sample-app/src/main/resources/META-INF/native-image/com.julien-dubois.bootui/bootui-spring-sample-app/reachability-metadata.json

# Validation harness work area: cloned applications, their Maven repository, logs, and collected evidence
/validation/.work/

# Local HyperFrames video projects and their renders; published videos live as GitHub Release assets
/videos/
