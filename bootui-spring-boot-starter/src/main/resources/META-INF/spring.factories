org.springframework.boot.EnvironmentPostProcessor=\
io.github.jdubois.bootui.autoconfigure.config.BootUiOverridesEnvironmentPostProcessor,\
io.github.jdubois.bootui.autoconfigure.config.BootUiActuatorDefaultsEnvironmentPostProcessor,\
io.github.jdubois.bootui.autoconfigure.config.BootUiStartupEnvironmentPostProcessor,\
io.github.jdubois.bootui.autoconfigure.config.BootUiWebApplicationTypeEnvironmentPostProcessor,\
io.github.jdubois.bootui.autoconfigure.javaagent.BootUiAgentClaimEnvironmentPostProcessor

org.springframework.context.ApplicationListener=\
io.github.jdubois.bootui.autoconfigure.compatibility.BootUiCompatibilityListener

org.springframework.boot.diagnostics.FailureAnalyzer=\
io.github.jdubois.bootui.autoconfigure.compatibility.BootUiCompatibilityFailureAnalyzer
