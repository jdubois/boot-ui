<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>@SPRING_BOOT_VERSION@</version>
        <relativePath/>
    </parent>
    <groupId>example</groupId>
    <artifactId>bootui-ci-consumer</artifactId>
    <version>1.0.0</version>
    <properties>
        <java.version>17</java.version>
        <spring.web.starter>spring-boot-starter-web</spring.web.starter>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>${spring.web.starter}</artifactId>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>webflux</id>
            <properties>
                <spring.web.starter>spring-boot-starter-webflux</spring.web.starter>
            </properties>
        </profile>
        <profile>
            <id>bootui-ci</id>
            <dependencies>
                <dependency>
                    <groupId>com.julien-dubois.bootui</groupId>
                    <artifactId>bootui-spring-boot-starter</artifactId>
                    <version>${bootui.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
