<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.julien-dubois.bootui</groupId>
        <artifactId>bootui-quarkus-integration-tests-aggregator</artifactId>
        <version>1.17.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>bootui-quarkus-fault-tolerance-integration-tests</artifactId>
    <name>BootUI :: Quarkus Extension (Fault Tolerance Integration Tests)</name>
    <description>Minimal, Docker-free Quarkus app that adds the quarkus-smallrye-fault-tolerance extension on
        top of the bootui-quarkus extension and proves the Fault Tolerance panel light-up: the MicroProfile Fault
        Tolerance annotations discovered at build time by the deployment processor's Jandex scan are recorded
        into a synthetic QuarkusFaultTolerancePolicies bean, mapped by QuarkusFaultTolerancePolicyProvider onto
        the neutral FaultTolerancePolicyDto contract (including MicroProfile config overrides and live named-breaker
        state), and surfaced on GET /bootui/api/fault-tolerance, with the panel reported available in the manifest.
        Kept separate from bootui-quarkus-integration-tests (which deliberately has NO fault-tolerance
        extension) so the extension-absent unavailable path and the extension-present capture path are each
        proven in isolation — the same split used for the Micrometer-, SmallRye-Health-, scheduler- and
        OpenTelemetry-present/absent coverage.</description>

    <!--
        Like the other Quarkus integration-test modules, this app has NO datasource / messaging dependencies, so
        a @QuarkusTest boots without Docker. It is never published.
    -->
    <dependencies>
        <!-- The extension under test. Brings bootui-engine, bootui-ui (the shared bundle), quarkus-rest and
             quarkus-vertx-http transitively, so this app serves /bootui/ and /bootui/api/** with no extra deps. -->
        <dependency>
            <groupId>com.julien-dubois.bootui</groupId>
            <artifactId>bootui-quarkus</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Explicit, provided-scope dependency on the deployment artifact — required for -T parallel-build
             safety, not just an optional courtesy. See bootui-quarkus-integration-tests/base/pom.xml for why. -->
        <dependency>
            <groupId>com.julien-dubois.bootui</groupId>
            <artifactId>bootui-quarkus-deployment</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Adds SmallRye Fault Tolerance. Its presence flips the SMALLRYE_FAULT_TOLERANCE capability, so the
             deployment processor's registerFaultTolerancePolicies build step captures the app's fault-tolerance
             annotations and lights up the Fault Tolerance panel. Without it the panel reports unavailable (proven in
             the sibling bootui-quarkus-integration-tests module). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
        </dependency>

        <!-- The shared, framework-neutral HTTP probe used to assert the /bootui/api/** responses. -->
        <dependency>
            <groupId>com.julien-dubois.bootui</groupId>
            <artifactId>bootui-conformance</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- forkCount=1: avoids a Quarkus @QuarkusTest classloading race between concurrent Surefire
                 forks in the same module (test-classes.idx); see
                 bootui-quarkus-integration-tests/base/pom.xml for the full rationale. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <forkCount>1</forkCount>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
