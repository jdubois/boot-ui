<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.julien-dubois.bootui</groupId>
        <artifactId>bootui-quarkus-parent</artifactId>
        <version>1.20.0</version>
        <relativePath>../bootui-quarkus-parent/pom.xml</relativePath>
    </parent>

    <artifactId>bootui-quarkus-deployment</artifactId>
    <name>BootUI :: Quarkus Extension (Deployment)</name>
    <description>Build-time half of the BootUI Quarkus extension: registers the console's beans, JAX-RS
        resources and the safety filter, and gates them to non-production launch modes.</description>

    <dependencies>
        <!-- Arc deployment brings AdditionalBeanBuildItem + the core deployment API (Feature/IndexDependency/
             LaunchMode build items) transitively. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc-deployment</artifactId>
        </dependency>
        <!-- Deployment counterparts of the runtime extension deps (quarkus-rest, quarkus-rest-jackson). The
             extension-descriptor goal verifies every runtime extension dependency has its -deployment pair
             here; these transitively pull vertx-http/vertx/jackson deployment modules. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-deployment</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson-deployment</artifactId>
        </dependency>
        <!-- Provides PreExceptionMapperHandlerBuildItem, the RESTEasy Reactive build-time extension point
             used to observe an exception before it is resolved by any ExceptionMapper (see
             QuarkusPreMappingExceptionCaptureHandler). Already resolvable transitively through
             quarkus-rest-deployment, but declared directly since its types are imported directly here. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-server-spi-deployment</artifactId>
        </dependency>
        <dependency>
            <groupId>com.julien-dubois.bootui</groupId>
            <artifactId>bootui-quarkus</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Plain JUnit 5 + AssertJ (versions managed by quarkus-bom) for the BasePackageRoots antichain
             unit test. The base-package reduction is pure logic, so it needs no Quarkus bootstrap. -->
        <!-- Test-only native augmentation fixture for additional secured methods and advisor ordering. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-internal</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: the MicroProfile / SmallRye Fault Tolerance annotations the fault tolerance scan reads.
             They are compiled into the test fixtures so the Jandex index the test builds is the real thing.
             Deliberately not a compile dependency: the scan matches annotations by DotName and must stay
             usable in an application that has no fault-tolerance extension at all. -->
        <dependency>
            <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
            <artifactId>microprofile-fault-tolerance-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.smallrye</groupId>
            <artifactId>smallrye-fault-tolerance-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.rest.client</groupId>
            <artifactId>microprofile-rest-client-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            The BootUI agent, for BootUiAgentLiveReloadLeakIT, which failsafe runs with -javaagent and this jar's path
            (${com.julien-dubois.bootui:bootui-agent:jar}), once the agent module has packaged it. Kept off every test
            class path: an agent jar is only ever loaded by -javaagent.
        -->
        <dependency>
            <groupId>com.julien-dubois.bootui</groupId>
            <artifactId>bootui-agent</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Published: Maven Central receives a flattened, parentless POM (configured in the root POM). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- The agent's heap walk, for BootUiAgentLiveReloadLeakIT. -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>com.julien-dubois.bootui:bootui-agent</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
            <plugin>
                <!-- Ten live reloads of a minimal application in a JVM started with the BootUI agent, after package. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Failsafe 3.6 no longer binds -DskipTests on its own; keep it skipping these ITs too. -->
                    <skipTests>${skipTests}</skipTests>
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <argLine>@{argLine} ${quarkus.test.argLine} -javaagent:${com.julien-dubois.bootui:bootui-agent:jar} -Xmx3g</argLine>
                    <systemPropertyVariables>
                        <bootui.agent.it.required>true</bootui.agent.it.required>
                    </systemPropertyVariables>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>com.julien-dubois.bootui:bootui-agent</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>io.quarkus</groupId>
                                    <artifactId>quarkus-extension-processor</artifactId>
                                    <version>${quarkus.platform.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
