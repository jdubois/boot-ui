<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.julien-dubois.bootui</groupId>
        <artifactId>bootui-parent</artifactId>
        <version>1.20.0</version>
    </parent>

    <artifactId>bootui-cli</artifactId>
    <name>BootUI :: CLI</name>
    <description>The bootui command-line interface, one subcommand per BootUI MCP tool, and the dependency-free Java
        client it is built on (package io.github.jdubois.bootui.client). Run the shaded "all" classifier.</description>

    <!--
        Two things share this artifact. The io.github.jdubois.bootui.client package is a framework-free Java client
        for the BootUI command-line endpoint, deliberately dependency-free at runtime, on the JDK's own HTTP client and
        a minimal JSON reader: a client is embedded in other people's builds, where an extra Jackson (2 or 3) on the
        classpath is a version conflict waiting to happen, and responses must stay opaque, because a client built
        against one BootUI version has to keep working against another, so it must not bind server payloads to DTO
        types from bootui-engine. ClientDependencyTests fails the build if the package reaches outside the JDK.

        The io.github.jdubois.bootui.cli package is the command line on top of it, which needs picocli. picocli is
        optional, so tooling that depends on this artifact for the client gets no dependency at all; the runnable
        artifact is the shaded "all" classifier below, which contains picocli.
    -->
    <dependencies>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
            <optional>true</optional>
        </dependency>

        <!--
            The engine is test-scoped only. It is the source the checked-in tool manifest is generated from,
            and the test that regenerates it is what fails the build when a tool is added to the MCP registry
            without being given a command. The CLI itself must not carry the engine: it has to run against
            applications on a different BootUI version than the one it was built with.
        -->
        <dependency>
            <groupId>com.julien-dubois.bootui</groupId>
            <artifactId>bootui-engine</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Published: Maven Central receives a flattened, parentless POM (configured in the root POM). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.github.jdubois.bootui.cli.BootUiCli</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!--
                The artifact people actually run is the shaded one: `java -jar` and JBang both need every
                dependency in a single file, and the CLI's dependency set is small enough — picocli plus the
                dependency-free client — that shading costs nothing and removes the classpath step. The shade
                plugin includes optional dependencies, so picocli is in it.

                It is attached under a classifier rather than replacing the main jar, so a build plugin can
                depend on the client without inheriting a shaded, unrelocatable picocli, or any picocli at all.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.jdubois.bootui.cli.BootUiCli</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
